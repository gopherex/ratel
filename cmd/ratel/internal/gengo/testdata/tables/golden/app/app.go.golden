	model.Home = ratel.NullFromPtr(null6)
	model.Type = ratel.Null[string]{V: null7.String, Valid: null7.Valid}
	model.Profile = ratel.NullFromPtr(null9)
	model.Doubled = ratel.Null[int64]{V: null10.Int64, Valid: null10.Valid}

	return model, nil
}

