	Manager    ratel.Loaded[*User]
	Users      ratel.Loaded[[]User]
	UserCount  ratel.Loaded[int64]
}

// Orders is the loaded Orders relation; ratel.ErrNotLoaded unless requested.
func (m *User) Orders() ([]Order, error) { return m.R.Orders.Get() }

// Manager is the loaded Manager relation; ratel.ErrNotLoaded unless requested.
func (m *User) Manager() (*User, error) { return m.R.Manager.Get() }

// Users is the loaded Users relation; ratel.ErrNotLoaded unless requested.
func (m *User) Users() ([]User, error) { return m.R.Users.Get() }

