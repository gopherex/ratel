// RegisterTypes loads the PostgreSQL types of this package whose OIDs pgx
// must know (composites, user ranges, arrays of user types) and registers
// the ratel value wrappers of composite fields. Call it on every
// connection, for example from pgxpool.Config.AfterConnect.
func RegisterTypes(ctx context.Context, conn *pgx.Conn) error {
	types := conn.TypeMap()

	for _, name := range []string{"app.address", "app._address"} {
		loaded, err := conn.LoadType(ctx, name)
		if err != nil {
			return fmt.Errorf("load type %s: %w", name, err)
		}

		types.RegisterType(loaded)
	}

	types.RegisterDefaultPgType(Address{}, "app.address")
	types.RegisterDefaultPgType([]*Address(nil), "app._address")
	types.RegisterDefaultPgType([]Address(nil), "app._address")

	if err := ratel.RegisterValue[string](types, "text"); err != nil {
		return err
	}

	if err := ratel.RegisterValue[string](types, "varchar"); err != nil {
		return err
	}

	return nil
}
