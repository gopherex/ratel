// Users describes app.users.
var Users = &usersTable{
	KeyedTable: usersBase,
	ID:         ratel.NewCol[User, int64]("id"),
	Email:      ratel.NewCol[User, Email]("email"),
	Status:     ratel.NewCol[User, UserStatus]("status"),
	ManagerID:  ratel.NewNullCol[User, int64]("manager_id"),
	Balance:    ratel.NewCol[User, decimal.Decimal]("balance"),
	Tags:       ratel.NewCol[User, []string]("tags"),
	Home:       ratel.NewNullCol[User, Address]("home"),
	Type:       ratel.NewNullCol[User, string]("type"),
	CreatedAt:  ratel.NewCol[User, time.Time]("created_at"),
	Profile:    ratel.NewNullCol[User, doc.Profile]("profile"),
	Doubled:    ratel.NewNullCol[User, int64]("doubled"),
	Orders: ratel.NewRel[User, Order](ordersBase, ratel.RelMany,
		[]ratel.RelKey[User]{{
			Column: "user_id", Parent: "id", Type: pgx.Identifier{"pg_catalog", "int8"},
			Values: func(models []User) any {
				out := make([]int64, len(models))
				for index, model := range models {
					out[index] = model.ID
				}

				return out
			},
		}},
		func(model *User, children []Order) {
			model.R.Orders = ratel.LoadedFrom(children)
		},
		ratel.RelCount[User, Order](func(model *User, count int64) { model.R.OrderCount = ratel.LoadedFrom(count) })),
	Manager: ratel.NewRel[User, User](usersBase, ratel.RelOne,
		[]ratel.RelKey[User]{{
			Column: "id", Parent: "manager_id", Type: pgx.Identifier{"pg_catalog", "int8"},
			Values: func(models []User) any {
				out := make([]*int64, len(models))
				for index, model := range models {
					out[index] = model.ManagerID.Ptr()
				}

				return out
			},
		}},
		func(model *User, children []User) {
			var value *User
			if len(children) > 0 {
				value = &children[0]
			}

			model.R.Manager = ratel.LoadedFrom(value)
		}),
	Users: ratel.NewRel[User, User](usersBase, ratel.RelMany,
		[]ratel.RelKey[User]{{
			Column: "manager_id", Parent: "id", Type: pgx.Identifier{"pg_catalog", "int8"},
			Values: func(models []User) any {
				out := make([]int64, len(models))
				for index, model := range models {
					out[index] = model.ID
				}

				return out
			},
		}},
		func(model *User, children []User) {
			model.R.Users = ratel.LoadedFrom(children)
		},
		ratel.RelCount[User, User](func(model *User, count int64) { model.R.UserCount = ratel.LoadedFrom(count) })),
}

type usersTable struct {
	ratel.KeyedTable[User, UserInsert]
	ID        ratel.Col[User, int64]
