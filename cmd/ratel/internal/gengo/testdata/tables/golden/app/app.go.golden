	Home      ratel.NullCol[User, Address]
	Type      ratel.NullCol[User, string]
	CreatedAt ratel.Col[User, time.Time]
	Profile   ratel.NullCol[User, doc.Profile]
	Doubled   ratel.NullCol[User, int64]
	Orders    ratel.Rel[User, Order]
	Manager   ratel.Rel[User, User]
	Users     ratel.Rel[User, User]
}

