// Order is a row of orders: its proto message and loaded relations.
type Order struct {
	*shopv1.Order
}

// ordersStoreID is the stored value of the column id.
func ordersStoreID(v int64) int64 {
	return v
}

// ordersReadID is the value of the column id in a message; absent is NULL.
func ordersReadID(m *shopv1.Order) int64 {
	return ordersStoreID(m.Id)
}

// ordersStoreKind is the stored value of the column kind.
func ordersStoreKind(v shopv1.OrderKind) string {
	return v.String()
}

// ordersReadKind is the value of the column kind in a message; absent is NULL.
func ordersReadKind(m *shopv1.Order) string {
	return ordersStoreKind(m.Kind)
}

// ordersStoreAudit is the stored value of the column audit.
func ordersStoreAudit(v shopv1.AuditKind) string {
	return v.String()
}

// ordersReadAudit is the value of the column audit in a message; absent is NULL.
func ordersReadAudit(m *shopv1.Order) string {
	return ordersStoreAudit(m.Audit)
}

func scanOrder(row pgx.Row) (Order, error) {
	model := Order{Order: &shopv1.Order{}}
	m := model.Order

	var scan1 string
	var scan2 string

	if err := row.Scan(&m.Id, &scan1, &scan2); err != nil {
		return model, err
	}

	{
		value, err := ratelpb.FromEnum[shopv1.OrderKind](shopv1.OrderKind_value, scan1)
		if err != nil {
			return model, err
		}
		m.Kind = value
	}

	{
		value, err := ratelpb.FromEnum[shopv1.AuditKind](shopv1.AuditKind_value, scan2)
		if err != nil {
			return model, err
		}
		m.Audit = value
	}

	return model, nil
}

// OrderInsert is the input of an insert into orders. Start it with Row.
type OrderInsert struct {
	id    int64
	kind  string
	audit string
	valid bool
}

// Row starts an insert row of orders: one step per required column, in column order.
func (t *ordersTable) Row() orderRowID {
	return orderRowID{}
}

type orderRowID struct{ insert OrderInsert }

// ID sets the column id.
func (s orderRowID) ID(v int64) orderRowKind {
	s.insert.id = ordersStoreID(v)

	return orderRowKind{s.insert}
}

type orderRowKind struct{ insert OrderInsert }

// Kind sets the column kind.
func (s orderRowKind) Kind(v shopv1.OrderKind) orderRowAudit {
	s.insert.kind = ordersStoreKind(v)

	return orderRowAudit{s.insert}
}

type orderRowAudit struct{ insert OrderInsert }

// Audit sets the column audit.
func (s orderRowAudit) Audit(v shopv1.AuditKind) OrderInsert {
	s.insert.audit = ordersStoreAudit(v)
	s.insert.valid = true

	return s.insert
}

// RowOf is an insert row of orders with every insertable column from the message; a
// column with a default keeps it while its field holds the zero value.
func (t *ordersTable) RowOf(m *shopv1.Order) OrderInsert {
	if m == nil {
		m = &shopv1.Order{}
	}

	return OrderInsert{
		id:    ordersReadID(m),
		kind:  ordersReadKind(m),
		audit: ordersReadAudit(m),
		valid: true,
	}
}

